{
  "expo": {
    "name": "Vesha",
    "slug": "vesha",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vesha",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vesha.wardrobe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF3EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "app.vesha.wardrobe",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F0F3F1"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vesha to access your photos so you can digitize clothing.",
          "cameraPermission": "Allow Vesha to use your camera to photograph clothing."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Vesha to use your location for weather-aware outfit suggestions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
