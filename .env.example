# Supabase (optional — without these the app runs in local demo mode)
# Create a free project at https://supabase.com → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# OpenAI key is NOT an Expo public env var.
# Set it on the Edge Function only:
#   supabase secrets set OPENAI_API_KEY=sk-...
# See supabase/functions/identify-clothing/README.md
